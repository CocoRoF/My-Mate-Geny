# ---- My Mate Geny: backend settings ----
# Copy to backend/.env (never commit it). Every setting is optional; the values
# shown are the defaults from backend/app/config.py. Names are case-insensitive.
# The backend reads ./.env and ../.env relative to its working directory; with
# docker compose this file is passed in as the container environment.
#
# Server state lives under ~/.hr-harnessor/ of the user running the backend
# (in Docker: /home/geny/.hr-harnessor in the `geny-home` volume).

# ---------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8080

# Origins allowed to call the API cross-origin (comma-separated). The console
# is served from the backend itself (same origin), so this only matters for the
# Vite dev server or other front-ends.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Built web console to serve (frontend/dist). Empty = API only (dev: use the
# Vite dev server instead). The Docker image sets /app/static.
STATIC_DIR=

# ---------------------------------------------------------------- login
# First login: admin / geny-admin. Change the password in Admin right after
# the first login (see docs/auth.md for how stored credentials and these
# variables interact).
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Signs the session cookie. Empty = auto key file ~/.hr-harnessor/session.key.
SESSION_SECRET=
# Browser session lifetime (sliding: refreshed on every request).
SESSION_TTL_DAYS=7
# Secure cookie flag. true behind HTTPS; false for plain http (e.g. LAN IP).
# With the root docker-compose.yml set it in the root .env instead: compose
# passes COOKIE_SECURE explicitly (default false there) and that wins.
COOKIE_SECURE=true
# Block an IP after this many failed logins, for this many hours.
MAX_LOGIN_FAILS=3
BAN_HOURS=24

# ---------------------------------------------------------------- storage
# SQLite database (sessions, events, accounts, mates, logs). ~ is expanded.
DB_PATH=./data/harnessor.db
# Fernet key for the secret vault (OAuth tokens, API keys, SSH keys). Empty =
# auto key file ~/.hr-harnessor/vault.key (0600). Losing the key loses the
# stored secrets. Generate a fixed one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
# Where remote workspaces would be sshfs-mounted (legacy; remote work now
# goes through SSH-backed MCP tools).
MOUNT_ROOT=~/.hr-harnessor/mounts
# Where Git repos are cloned (each becomes a local workspace).
REPOS_ROOT=~/.hr-harnessor/repos
# Chat attachments, per session.
UPLOADS_ROOT=~/.hr-harnessor/uploads
UPLOAD_MAX_MB=50
UPLOAD_MAX_FILES=20
# Admin error-log retention (oldest rows pruned beyond this).
LOG_MAX_ROWS=20000

# ---------------------------------------------------------------- engines
# Provider CLI binaries (on PATH, or absolute paths).
CLAUDE_BINARY=claude
CODEX_BINARY=codex
# Wall-clock limit of a single agent turn, seconds.
TURN_TIMEOUT_S=600

# ---------------------------------------------------------------- mate
# Per-mate files, the Live2D Cubism Core (once you accept its licence in the
# UI) and the speech cache.
MATES_ROOT=~/.hr-harnessor/mates
MATE_ASSET_MAX_MB=200
MATE_IMPORT_MAX_MB=600
# Where the mate's find_folders tool looks for project folders (comma-separated).
# The Docker image sets /workspaces.
MATE_SEARCH_ROOTS=/home
# Voice provider API bases (point at a proxy / compatible server if needed).
# API keys are not set here: enter them in Mate > Settings (stored in the vault).
MATE_OPENAI_BASE=https://api.openai.com/v1
MATE_ELEVENLABS_BASE=https://api.elevenlabs.io/v1

# ---------------------------------------------------------------- app downloads
# The console's Download page lists the desktop/Android builds of a GitHub
# release. Forks publishing their own builds: point APPS_REPO at your repo.
# GITHUB_TOKEN (read access) is only needed when that repo is private.
APPS_REPO=CocoRoF/hr-harnessor
APPS_RELEASE_TAG=apps-latest
GITHUB_TOKEN=
