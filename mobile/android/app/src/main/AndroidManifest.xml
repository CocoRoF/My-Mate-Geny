<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- usesCleartextTraffic: the user picks the server, and a self-hosted one
         on the home network is often plain http://192.168.x.x:port. Without
         this, Android 9+ refuses http:// in both the WebView and native HTTP.
         https:// servers are unaffected; addresses without a scheme try
         https:// first unless they are local (www/connect-core.js). -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Her calls with the app closed (docs/mate-calls.md "On Android"): one line held open to the user's own server
             (there is no push service), and during a call the microphone kept with the screen locked. -->
        <service
            android:name=".GenyLinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to the user's own self-hosted server so their companion can ring them like a phone call; the app has no push service." />
        </service>
        <!-- 거절 / 끊기 on a call's notification, without opening the app -->
        <receiver android:name=".CallActionReceiver" android:exported="false" />
        <!-- the link comes back after a reboot and after an update -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- The attach menu's Camera (<input capture>): Capacitor's BridgeWebChromeClient
         only launches the camera when resolveActivity(IMAGE_CAPTURE) finds an app,
         and since Android 11 package visibility hides every camera app unless the
         intent is declared here — without this it silently opens the photo picker. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Turn finished" notifications (Android 13+ asks at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Take a photo straight from the attach menu -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Talking to the Mate (push-to-talk, getUserMedia audio). Capacitor's
         BridgeWebChromeClient.onPermissionRequest asks for both at runtime
         when the page requests the microphone and grants the WebView only
         if all are granted, so both must be declared. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The mate calling you (GenyCallPlugin, docs/mate-calls.md): her ringing as a call notification that comes up
         over the lock screen while the app is in the background, and the phone's vibration while it rings -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- …and with the app closed: the background link (GenyLinkService) — a foreground service, back after a reboot,
         awake for a moment to ring, the microphone kept during a call, and the user may let it skip battery optimisation -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Download page: open the installer for a new version downloaded in the app (GenyServerPlugin.installApk) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
