{
  "appId": "me.hrletsgo.harnessor",
  "appName": "My Mate Geny",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a0c10"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0a0c10",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0a0c10"
    },
    "LocalNotifications": {
      "iconColor": "#6e8bff"
    }
  }
}
