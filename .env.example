# ---- hr-harnessor backend configuration ----

# Server bind
HOST=0.0.0.0
PORT=8080

# CORS — comma-separated origins allowed to call the API (web/mobile dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite database (sessions, connections, provider auth metadata)
DB_PATH=./data/harnessor.db

# Secret vault. If VAULT_KEY is empty, a key file is auto-created at
# ~/.hr-harnessor/vault.key (chmod 600). To use a fixed key, generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# Where remote workspaces are sshfs-mounted on this runtime host (2223)
MOUNT_ROOT=~/.hr-harnessor/mounts

# Path to the claude CLI binary (defaults to whatever is on PATH)
CLAUDE_BINARY=claude

# Path to the codex CLI binary (not installed yet — interface only)
CODEX_BINARY=codex

# Default subprocess wall-clock timeout for a single agent turn (seconds)
TURN_TIMEOUT_S=600
