# ---- My Mate Geny: docker compose settings ----
# Copy to `.env` next to docker-compose.yml. Every line is optional.
# App settings (login, CORS, limits, ...) go in backend/.env — see
# backend/.env.example.

# Host port and bind address of the console. 127.0.0.1 = this machine only;
# 0.0.0.0 = reachable from your network (put HTTPS in front, docs/deploy.md).
GENY_PORT=8080
GENY_BIND=127.0.0.1

# uid/gid of the container user. Match your host user (`id -u`, `id -g`) when
# you bind-mount host folders below, so the agents can write to them.
GENY_UID=1000
GENY_GID=1000

# Host folder mounted at /workspaces (the folders agents work in). Leave unset
# to use a docker volume instead.
# GENY_WORKSPACES=/srv/projects

# Secure session cookie: auto = Secure on https requests (works for plain-http
# LAN servers and HTTPS alike); true forces it always.
COOKIE_SECURE=auto
