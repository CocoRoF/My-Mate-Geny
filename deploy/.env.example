# ---- deploy/docker-compose.yml settings ----
# Copy to deploy/.env (gitignored). App settings go in backend/.env.

# Console port on 127.0.0.1 (your reverse proxy forwards to it).
GENY_PORT=8080

# Container user; match the owner of the host folders you mount (`id -u`/`id -g`).
GENY_UID=1000
GENY_GID=1000

# Server state (DB, vault/session keys, account logins, mates, uploads).
# Unset = the `geny-home` docker volume; or a host directory owned by GENY_UID.
# GENY_HOME=/srv/geny/home

# Folders the agents work in, mounted at /workspaces.
# GENY_WORKSPACES=/srv/projects

# Secure session cookie (keep true when served over HTTPS).
COOKIE_SECURE=true

# Token of a remotely-managed Cloudflare tunnel (`--profile tunnel`).
# CLOUDFLARE_TUNNEL_TOKEN=
