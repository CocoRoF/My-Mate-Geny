{
  "name": "hr-harnessor-desktop",
  "productName": "My Mate Geny",
  "version": "0.4.0",
  "description": "My Mate Geny — agent console and desktop Mate",
  "main": "src/main.js",
  "desktopName": "my-mate-geny.desktop",
  "author": "My Mate Geny contributors",
  "homepage": "https://github.com/CocoRoF/My-Mate-Geny",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "me.hrletsgo.harnessor",
    "productName": "My Mate Geny",
    "copyright": "My Mate Geny contributors",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "afterPack": "build/after-pack.js",
    "publish": [{ "provider": "generic", "url": "https://updates.invalid/set-at-runtime" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "my-mate-geny-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "My Mate Geny",
      "uninstallDisplayName": "My Mate Geny"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "my-mate-geny-${version}-macos-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "My Mate Geny uses the microphone when you talk to your Mate (push-to-talk)."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "executableName": "my-mate-geny",
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "My Mate Geny contributors <my-mate-geny@users.noreply.github.com>",
      "synopsis": "My Mate Geny – agent console for Claude Code & Codex, with a desktop Mate",
      "executableArgs": ["--ozone-platform=x11"],
      "artifactName": "my-mate-geny-${version}-linux-${arch}.${ext}",
      "desktop": {
        "GenericName": "Agent console",
        "Keywords": "agent;console;claude;codex;mate;geny;"
      }
    },
    "deb": {
      "packageName": "my-mate-geny",
      "packageCategory": "devel",
      "fpm": [
        "--replaces", "hr-harnessor-desktop",
        "--conflicts", "hr-harnessor-desktop",
        "--provides", "hr-harnessor-desktop",
        "--description", "My Mate Geny – agent console for Claude Code & Codex, with a desktop Mate\nMy Mate Geny is the desktop app for your own My Mate Geny server: its agent\nconsole for Claude Code and Codex sessions in a native window, and the Mate,\nyour companion character, on the desktop (tray, quick chat, start at login).\n.\nFormerly packaged as hr-harnessor-desktop: installing this package replaces\nthat one and keeps your settings and sign-in."
      ],
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "afterInstall": "build/deb-postinst.tpl",
      "afterRemove": "build/deb-postrm.tpl"
    }
  }
}
