{
  "name": "hr-harnessor-desktop",
  "productName": "My Mate Geny",
  "version": "0.4.0",
  "description": "My Mate Geny — agent console and desktop Mate",
  "main": "src/main.js",
  "author": "My Mate Geny contributors",
  "homepage": "https://github.com/CocoRoF/My-Mate-Geny",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "me.hrletsgo.harnessor",
    "productName": "My Mate Geny",
    "copyright": "My Mate Geny contributors",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "afterPack": "build/after-pack.js",
    "publish": [{ "provider": "generic", "url": "https://updates.invalid/set-at-runtime" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "my-mate-geny-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "My Mate Geny",
      "uninstallDisplayName": "My Mate Geny"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "my-mate-geny-${version}-macos-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "My Mate Geny uses the microphone when you talk to your Mate (push-to-talk)."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "My Mate Geny contributors <my-mate-geny@users.noreply.github.com>",
      "synopsis": "Agent console for Claude Code & Codex, with a desktop Mate",
      "executableArgs": ["--ozone-platform=x11"],
      "artifactName": "my-mate-geny-${version}-linux-${arch}.${ext}"
    },
    "deb": { "depends": ["libnotify4", "libxtst6", "libnss3"] }
  }
}
