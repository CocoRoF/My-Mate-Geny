{
  "name": "hr-harnessor-desktop",
  "productName": "hr-harnessor",
  "version": "0.2.0",
  "description": "hr·harnessor agent console — desktop app",
  "main": "src/main.js",
  "author": "hr-harnessor <noreply@hrletsgo.me>",
  "homepage": "https://agent.hrletsgo.me",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "me.hrletsgo.harnessor",
    "productName": "hr-harnessor",
    "copyright": "hr-harnessor",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "afterPack": "build/after-pack.js",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "hr-harnessor-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "hr-harnessor"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "hr-harnessor-${version}-macos-${arch}.${ext}"
    },
    "dmg": { "title": "hr-harnessor ${version}" },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "hr-harnessor <noreply@hrletsgo.me>",
      "synopsis": "Agent console for Claude Code & Codex",
      "artifactName": "hr-harnessor-${version}-linux-${arch}.${ext}"
    },
    "deb": { "depends": ["libnotify4", "libxtst6", "libnss3"] }
  }
}
