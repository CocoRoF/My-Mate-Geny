<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8, and Python's ctypes in the bundled runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- the bundled Python loads extension modules, and packages the user installs later are not signed by this team -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- talking to the Mate: without it the hardened runtime keeps the microphone away, whatever the user answers -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
